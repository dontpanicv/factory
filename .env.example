# Factory settings. Copy this file to .env. An empty value counts as not set.

# Factory always listens on 127.0.0.1. A tunnel or a reverse proxy on the host serves it.
# Under portless (bun run dev/start), portless sets PORT and PORTLESS_URL (https://factory.localhost).
PORT=4310
# Public origin of the UI. Default: PORTLESS_URL, or http://localhost:<PORT>.
FACTORY_URL=
# The SQLite files: the app database (factory.sqlite, with the Better Auth tables) and the board (board/local.db).
FACTORY_DATA_DIR=data

# Sign-in. Without GOOGLE_CLIENT_ID, Factory runs in local mode: no sign-in,
# and it accepts only requests for localhost or *.localhost names (portless).
# With GOOGLE_CLIENT_ID, all Google values are required. The OAuth redirect is
# <FACTORY_URL>/api/auth/callback/google; Google does not accept *.localhost redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
# Only members of this Google Group can sign in (nested groups in the same domain count).
FACTORY_ACCESS_GROUP=
# Service account key (JSON). The service account needs the "Groups Reader" admin role.
GOOGLE_SA_KEY_FILE=
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
