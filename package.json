{
  "name": "factory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server/main.ts --compile --production --outfile=dist/factory",
    "check": "ultracite check",
    "dev": "portless factory bun --watch src/server/main.ts",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "serve": "NODE_ENV=production portless factory dist/factory",
    "start": "NODE_ENV=production portless factory bun src/server/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run check && bun test"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.5",
    "@effect/sql-sqlite-bun": "4.1.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@vercel/board": "0.53.0",
    "better-auth": "1.7.7",
    "effect": "4.1.5",
    "google-auth-library": "^11.1.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/language-service": "^0.87.3",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.16",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.4.2"
}
