{
  "name": "factory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --compile --production --outfile=dist/factory",
    "check": "ultracite check",
    "dev": "portless factory bun --watch src/main.ts",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "serve": "NODE_ENV=production portless factory dist/factory",
    "start": "NODE_ENV=production portless factory bun src/main.ts",
    "test": "playwright test",
    "typecheck": "effect-tsgo tsc --noEmit",
    "verify": "bun run typecheck && bun run check && bun run test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.1",
    "@earendil-works/pi-ai": "1.6.1",
    "@earendil-works/pi-durable": "1.6.1",
    "@earendil-works/pi-env": "1.6.1",
    "@earendil-works/pi-schema": "1.6.1",
    "@effect/platform-bun": "4.1.5",
    "@effect/sql-sqlite-bun": "4.1.5",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@vercel/board": "0.53.0",
    "better-auth": "1.7.7",
    "effect": "4.1.5",
    "google-auth-library": "^11.1.0",
    "preact": "^11.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/tsgo": "^0.73.4",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.2",
    "@types/proper-lockfile": "^4.1.4",
    "lefthook": "^2.1.16",
    "typescript": "^7.0.2",
    "ultracite": "7.12.2"
  },
  "packageManager": "bun@1.4.2"
}
