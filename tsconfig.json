{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "plugins": [
      {
        // Effect diagnostics in `tsc` (the `@effect/tsgo` build of TypeScript 7).
        "name": "@effect/language-service",
        // Effect 4 marks its HTTP, SQL and platform modules as unstable. Factory is built on them.
        "diagnosticSeverity": { "unstableApiUsage": "off" },
        "ignoreEffectSuggestionsInTscExitCode": false
      }
    ]
  },
  "include": ["src", "e2e", "playwright.config.ts"]
}
